<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/GameHUD.uss?fileID=7433441132597879392&amp;guid=344e0703ce189dc4a8d3f0c30ba693b1&amp;type=3#GameHUD" />
    <ui:VisualElement name="HUDContainer">
        <ui:VisualElement name="StartPanel">
            <ui:VisualElement name="StartCard">
                <ui:Label name="StartTitle" text="Monster Treasure Hunt" />
                <ui:Label name="StartSubtitle" text="A clumsy little monster, a huge island, and hidden treasure." />
                <ui:Button name="StartButton" text="Start Game" />
                <ui:Button name="StartQuitButton" text="Quit" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MapSelectPanel" display="none">
            <ui:VisualElement name="MapSelectCard">
                <ui:Label name="MapSelectTitle" text="Select Map" />
                <ui:Button name="BeginnerMapButton" text="Beginner Island" />
                <ui:Button name="FoggyMapButton" text="Foggy Forest" />
                <ui:Button name="VolcanoMapButton" text="Volcano Cave" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SkinSelectPanel" display="none">
            <ui:VisualElement name="SkinSelectCard">
                <ui:Label name="SkinSelectTitle" text="Skin" />
                <ui:VisualElement name="SkinSelectContent">
                    <ui:VisualElement name="SkinPreviewPane">
                        <ui:Image name="SkinPreviewImage" />
                        <ui:Label name="SkinNameLabel" text="Purple" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SkinOptionList">
                        <ui:Button name="PurpleSkinButton" text="Purple" />
                        <ui:Button name="GreenSkinButton" text="Green" />
                        <ui:Button name="PinkSkinButton" text="Pink" />
                        <ui:Button name="YellowSkinButton" text="Yellow" />
                        <ui:Button name="BeigeSkinButton" text="Beige" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="SkinActionRow">
                    <ui:Button name="BackToMapButton" text="Back" />
                    <ui:Button name="ConfirmSkinButton" text="Confirm" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="SettingsButton" text="Settings" />
        <ui:VisualElement name="LivesContainer" display="none" picking-mode="Ignore">
            <ui:Image name="LifeHeart1" />
            <ui:Image name="LifeHeart2" />
            <ui:Image name="LifeHeart3" />
        </ui:VisualElement>
        <ui:Button name="InventoryButton" text="Inventory" display="none" />
        <ui:VisualElement name="InventoryPanel" display="none">
            <ui:Label name="InventoryTitle" text="Collected Items" />
            <ui:VisualElement name="InventoryItemRow">
                <ui:Image name="InventoryKeyIcon" />
                <ui:Label name="InventoryKeyLabel" text="Yellow Key  x0" />
            </ui:VisualElement>
            <ui:Label name="InventoryHint" text="Press I to close" />
        </ui:VisualElement>
        <ui:Label name="ChestLockedMessage" text="The chest is locked. Find the yellow key." display="none" />
        <ui:VisualElement name="SettingsPanel" display="none">
            <ui:Button name="HelpButton" text="Help" />
            <ui:Button name="ContinueButton" text="Continue" />
            <ui:Button name="EscapeButton" text="Escape" />
        </ui:VisualElement>
        <ui:VisualElement name="RulesPanel" display="none">
            <ui:Label name="RulesTitle" text="Game Rules" />
            <ui:Label name="RulesLabel" />
        </ui:VisualElement>
        <ui:Label name="FailureIcon" text="X" display="none" />
        <ui:Label name="ResultLabel" display="none" />
        <ui:VisualElement name="VictoryPanel" display="none">
            <ui:VisualElement name="VictoryCard">
                <ui:Label name="VictoryTitle" text="Treasure Unlocked!" />
                <ui:Label name="VictoryMessage" text="You used the yellow key and cleared the island." />
                <ui:Label name="VictoryReward" text="Victory" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ScentIndicator" style="top: 100%; left: 100%; display: none; width: 64px; height: 64px; background-image: url(&quot;project://database/Assets/_Project/Art/arrow.png?fileID=21300000&amp;guid=55a1856c69c2b5247a8437246e3fe4e7&amp;type=3#arrow&quot;); background-color: rgb(255, 255, 255); -unity-background-scale-mode: scale-to-fit;" />
    </ui:VisualElement>
</ui:UXML>
