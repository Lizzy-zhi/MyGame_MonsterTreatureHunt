#HUDContainer {
    position: relative;
    width: 100%;
    height: 100%;
}

#StartPanel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(8, 16, 28, 0.78);
}

#MapSelectPanel,
#SkinSelectPanel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(8, 16, 28, 0.78);
}

#StartCard {
    width: 760px;
    max-width: 86%;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 28px;
    padding-bottom: 28px;
    background-color: rgba(10, 22, 40, 0.9);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.82);
    border-radius: 10px;
}

#MapSelectCard,
#SkinSelectCard {
    width: 640px;
    max-width: 80%;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 24px;
    padding-bottom: 24px;
    background-color: rgba(10, 22, 40, 0.9);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.82);
    border-radius: 10px;
}

#SkinSelectCard {
    width: 760px;
    height: 520px;
    background-color: rgb(246, 248, 252);
    border-color: rgb(210, 215, 225);
}

#StartTitle {
    font-size: 46px;
    -unity-font-style: bold;
    color: #ffe082;
    -unity-text-align: upper-left;
    margin-bottom: 12px;
}

#MapSelectTitle,
#SkinSelectTitle {
    font-size: 38px;
    -unity-font-style: bold;
    color: #ffe082;
    margin-bottom: 16px;
}

#SkinSelectTitle {
    color: rgb(25, 25, 25);
    font-size: 34px;
}

#SkinSelectContent {
    flex-direction: row;
    flex-grow: 1;
}

#SkinPreviewPane {
    width: 430px;
    justify-content: center;
    align-items: center;
}

#SkinPreviewImage {
    width: 250px;
    height: 280px;
    -unity-background-scale-mode: scale-to-fit;
}

#SkinNameLabel {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(35, 35, 35);
    margin-top: 12px;
}

#SkinOptionList {
    width: 260px;
    justify-content: center;
}

#PurpleSkinButton,
#GreenSkinButton,
#PinkSkinButton,
#YellowSkinButton,
#BeigeSkinButton {
    height: 48px;
    font-size: 22px;
    margin-bottom: 12px;
    color: rgb(35, 35, 35);
    background-color: rgb(250, 250, 250);
    border-width: 2px;
    border-color: rgb(140, 145, 155);
    border-radius: 8px;
    -unity-font-style: bold;
}

#PurpleSkinButton.skin-option-selected,
#GreenSkinButton.skin-option-selected,
#PinkSkinButton.skin-option-selected,
#YellowSkinButton.skin-option-selected,
#BeigeSkinButton.skin-option-selected {
    color: rgb(15, 60, 120);
    background-color: rgb(221, 235, 255);
    border-color: rgb(85, 125, 215);
}

#SkinActionRow {
    height: 56px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

#BackToMapButton,
#ConfirmSkinButton {
    width: 120px;
    height: 44px;
    margin-left: 12px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(25, 25, 25);
    background-color: rgb(245, 245, 245);
    border-width: 2px;
    border-color: rgb(80, 80, 80);
    border-radius: 8px;
}

#ConfirmSkinButton {
    color: white;
    background-color: rgb(50, 115, 220);
    border-color: rgb(35, 80, 170);
}

#StartSubtitle {
    font-size: 25px;
    color: rgb(242, 245, 250);
    white-space: normal;
    margin-bottom: 24px;
}

#StartButton {
    height: 62px;
    font-size: 30px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    color: rgb(20, 20, 20);
    background-color: rgb(245, 245, 245);
    border-width: 2px;
    border-color: rgb(60, 60, 60);
    border-radius: 8px;
}

#BeginnerMapButton,
#FoggyMapButton,
#VolcanoMapButton {
    height: 58px;
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    color: rgb(20, 20, 20);
    background-color: rgb(245, 245, 245);
    border-width: 2px;
    border-color: rgb(60, 60, 60);
    border-radius: 8px;
}

#VolcanoMapButton {
    margin-bottom: 0;
}

#StartQuitButton {
    height: 56px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(20, 20, 20);
    background-color: rgb(245, 245, 245);
    border-width: 2px;
    border-color: rgb(60, 60, 60);
    border-radius: 8px;
}

#SettingsButton {
    position: absolute;
    left: 32px;
    top: 32px;
    min-width: 180px;
    height: 72px;
    font-size: 34px;
    -unity-font-style: bold;
    padding-left: 24px;
    padding-right: 24px;
    color: rgb(20, 20, 20);
    background-color: rgb(245, 245, 245);
    border-width: 3px;
    border-color: rgb(60, 60, 60);
    border-radius: 10px;
}

#LivesContainer {
    position: absolute;
    right: 240px;
    top: 32px;
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(0, 0, 0, 0.42);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.76);
    border-radius: 8px;
}

#LifeHeart1,
#LifeHeart2,
#LifeHeart3 {
    width: 44px;
    height: 44px;
    margin-left: 5px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

#InventoryButton {
    position: absolute;
    right: 32px;
    top: 32px;
    min-width: 180px;
    height: 64px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(20, 20, 20);
    background-color: rgb(245, 245, 245);
    border-width: 3px;
    border-color: rgb(60, 60, 60);
    border-radius: 10px;
}

#InventoryPanel {
    position: absolute;
    right: 32px;
    top: 112px;
    width: 330px;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 18px;
    padding-bottom: 18px;
    background-color: rgba(0, 0, 0, 0.78);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.85);
    border-radius: 10px;
}

#InventoryTitle {
    font-size: 30px;
    -unity-font-style: bold;
    color: #ffe082;
    margin-bottom: 12px;
}

#InventoryItemRow {
    height: 58px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

#InventoryKeyIcon {
    width: 42px;
    height: 42px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

#InventoryKeyLabel {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
}

#InventoryHint {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.72);
    margin-top: 4px;
}

#ChestLockedMessage {
    position: absolute;
    left: 50%;
    top: 24%;
    width: 680px;
    margin-left: -340px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 14px;
    padding-bottom: 14px;
    font-size: 30px;
    color: #ffe082;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.76);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.86);
    border-radius: 10px;
}

#SettingsPanel {
    position: absolute;
    left: 32px;
    top: 120px;
    width: 300px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 18px;
    padding-bottom: 18px;
    background-color: rgba(0, 0, 0, 0.78);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.85);
    border-radius: 10px;
}

#SettingsPanel Button {
    height: 58px;
    margin-bottom: 12px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(20, 20, 20);
    background-color: rgb(245, 245, 245);
    border-width: 2px;
    border-color: rgb(60, 60, 60);
    border-radius: 8px;
}

#EscapeButton {
    margin-bottom: 0;
}

#RulesPanel {
    position: absolute;
    left: 360px;
    top: 120px;
    width: 720px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 22px;
    padding-bottom: 22px;
    background-color: rgba(0, 0, 0, 0.78);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.85);
    border-radius: 10px;
}

#RulesTitle {
    font-size: 34px;
    -unity-font-style: bold;
    color: #ffe082;
    margin-bottom: 12px;
}

#RulesLabel {
    font-size: 26px;
    color: white;
    white-space: normal;
}

#ResultLabel {
    position: absolute;
    left: 32px;
    top: 120px;
    font-size: 40px;
    color: #ffe082;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.75);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
    border-radius: 12px;
    max-width: 900px;
    white-space: normal;
}

#VictoryPanel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(8, 16, 28, 0.58);
}

#VictoryCard {
    width: 720px;
    max-width: 84%;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 30px;
    padding-bottom: 30px;
    background-color: rgba(10, 22, 40, 0.93);
    border-width: 3px;
    border-color: rgba(255, 224, 130, 0.92);
    border-radius: 10px;
    align-items: center;
}

#VictoryTitle {
    font-size: 46px;
    -unity-font-style: bold;
    color: #ffe082;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

#VictoryMessage {
    font-size: 28px;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 18px;
}

#VictoryReward {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(25, 25, 25);
    -unity-text-align: middle-center;
    background-color: rgb(255, 224, 130);
    border-width: 2px;
    border-color: rgb(255, 247, 196);
    border-radius: 8px;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 10px;
    padding-bottom: 10px;
}

#FailureIcon {
    position: absolute;
    left: 50%;
    top: 38%;
    width: 116px;
    height: 116px;
    margin-left: -58px;
    margin-top: -58px;
    font-size: 82px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgb(190, 45, 45);
    border-width: 5px;
    border-color: white;
    border-radius: 58px;
}

#ScentIndicator {
    width: 78px;
    height: 78px;
    background-repeat: no-repeat;
    background-size: contain;
    position: absolute;
    opacity: 0.95;
    transform-origin: center;
}
